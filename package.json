{
  "name": "blog_project",
  "version": "1.0.0",
  "description": "Minimal Swiss-style blog built with Next.js, Tailwind, Supabase, and Tiptap.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev apps/admin",
    "dev:public": "next dev apps/public",
    "build": "next build apps/admin",
    "build:public": "next build apps/public",
    "typecheck:public": "tsc -p apps/public/tsconfig.json --noEmit --incremental false",
    "start": "next start apps/admin",
    "start:public": "next start apps/public",
    "lint": "eslint .",
    "test": "vitest run --config config/testing/vitest.config.ts",
    "test:governance": "node scripts/check-contract-governance.mjs"
  },
  "keywords": [
    "nextjs",
    "supabase",
    "blog",
    "tiptap"
  ],
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.78.0",
    "@tiptap/extension-image": "^3.11.0",
    "@tiptap/extension-link": "^3.11.0",
    "@tiptap/extension-placeholder": "^3.11.0",
    "@tiptap/extension-table": "^3.11.0",
    "@tiptap/extension-table-cell": "^3.11.0",
    "@tiptap/extension-table-header": "^3.11.0",
    "@tiptap/extension-table-row": "^3.11.0",
    "@tiptap/pm": "^3.11.0",
    "@tiptap/react": "^3.11.0",
    "@tiptap/starter-kit": "^3.11.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.15",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
